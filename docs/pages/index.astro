---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

const { config } = data;

const guideGroup = data.navigation.sidebar.find(
  (node) => node.kind === "group" && node.path === "/guides"
);
const guides =
  guideGroup?.kind === "group"
    ? guideGroup.children.filter((node) => node.kind === "page")
    : [];
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{
    title: "Soleaux repository intelligence documentation",
    description: config.description,
  }}
  searchEnabled={config.search.enabled}
  site={{ title: config.title, description: config.description }}
  siteUrl={config.site}
  themeMode={config.theme.mode}
>
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <section class="max-w-3xl">
      <p
        class="mb-4 font-mono font-medium text-accent text-sm uppercase tracking-[0.16em]"
      >
        Repository intelligence for coding agents
      </p>
      <h1
        class="m-0 text-balance font-semibold text-4xl tracking-tight sm:text-6xl"
      >
        Understand the repository before you change it.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted-foreground leading-8">
        Soleaux provides bounded structural analysis, optional language-server
        semantics, typed relation tables, source evidence, and hash-bound editor
        previews through a reusable stdio FastMCP server. A separately owned
        workspace composition can expose the same catalog over authenticated,
        loopback HTTP.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          class="inline-flex items-center rounded-blume bg-accent px-4 py-2.5 font-medium text-accent-foreground text-sm no-underline transition-opacity hover:opacity-90"
          href="/guides/agent-workflow"
        >
          Agent workflow
        </a>
        <a
          class="inline-flex items-center rounded-blume border border-border px-4 py-2.5 font-medium text-sm no-underline transition-colors hover:bg-muted"
          href="/guides/tool-catalog"
        >
          Tool catalog
        </a>
      </div>
    </section>

    <section aria-labelledby="guides-heading" class="mt-20">
      <div class="mb-6 flex items-end justify-between gap-6">
        <div>
          <p class="m-0 text-muted-foreground text-sm">Reference and workflows</p>
          <h2 class="mt-1 mb-0 text-2xl font-semibold" id="guides-heading">
            Soleaux guides
          </h2>
        </div>
      </div>
      <ul class="m-0 grid list-none gap-4 p-0 md:grid-cols-2">
        {
          guides.map((guide) => (
            <li>
              <a
                class="group flex h-full flex-col rounded-blume border border-border bg-background p-5 text-inherit no-underline transition-colors hover:border-accent hover:bg-muted/30"
                href={guide.route}
              >
                <h3 class="m-0 text-base font-semibold">{guide.label}</h3>
                {
                  guide.description && (
                    <p class="mt-2 mb-4 text-muted-foreground text-sm leading-6">
                      {guide.description}
                    </p>
                  )
                }
                <span
                  aria-hidden="true"
                  class="mt-auto text-accent text-sm transition-transform group-hover:translate-x-1"
                >
                  &rarr;
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-20 border-border border-t pt-8">
      <h2 class="m-0 text-xl font-semibold">Run Soleaux</h2>
      <p class="mt-3 max-w-2xl text-muted-foreground leading-7">
        Start the installed command at the repository you want to inspect, then
        begin with <code>context</code> and read the
        <code>soleaux://about</code> resource for the component catalog.
      </p>
      <pre
        class="mt-5 overflow-x-auto rounded-blume border border-border bg-muted/40 p-4 font-mono text-sm"
      ><code>soleaux --root /path/to/repository</code></pre>
    </section>
  </div>
</PageLayout>
