"


def materialize_payload() -> None:
    encoded = base64.b64decode(PAYLOAD_B64)
    with tarfile.open(fileobj=io.BytesIO(encoded), mode="r:gz") as archive:
        for member in archive.getmembers():
            target = (ROOT / member.name).resolve()
            if ROOT.resolve() not in target.parents:
                raise SystemExit(f"unsafe payload path: {member.name}")
        archive.extractall(ROOT, filter="data")


materialize_payload()


def read(path: str) -> str:
    return (ROOT / path).read_text(encoding="utf-8")


def write(path: str, content: str) -> None:
    (ROOT / path).write_text(content, encoding="utf-8")


def replace_once(content: str, old: str, new: str, label: str) -> str:
    count = content.count(old)
    if count != 1:
        raise SystemExit(f"{label}: expected one source match, found {count}")
    return content.replace(old, new, 1)


lib = read("native/daemon/ipc/src/lib.rs")
lib = replace_once(
    lib,
    "mod client;\nmod paths;\n",
    "mod client;\nmod compatibility;\nmod paths;\n",
    "declare compatibility module",
)
lib = replace_once(
    lib,
    "pub use client::IpcClient;\n",
    "pub use client::IpcClient;\n"
    "pub use compatibility::{\n"
    "    CLIENT_CAPABILITY_MATRIX_JSON, CLIENT_CAPABILITY_MATRIX_SCHEMA_VERSION,\n"
    "    CLIENT_CAPABILITY_PROBE_SCHEMA_VERSION, client_capability_matrix_sha256,\n"
    "    client_capability_matrix_summary, validate_client_capability_matrix,\n"
    "};\n",
    "export capability matrix contract",
)
write("native/daemon/ipc/src/lib.rs", lib)

cargo = read("native/daemon/ipc/Cargo.toml")
cargo = replace_once(
    cargo,
    "serde_json.workspace = true\nsoleaux-state = { path = \"../state\" }\n",
    "serde_json.workspace = true\nsha2.workspace = true\nsoleaux-state = { path = \"../state\" }\n",
    "add capability matrix digest dependency",
)
write("native/daemon/ipc/Cargo.toml", cargo)

registry = read("native/daemon/ipc/src/registry.rs")
registry = replace_once(
    registry,
    "use crate::IPC_MAX_FRAME_BYTES;\n",
    "use crate::{\n"
    "    IPC_MAX_FRAME_BYTES,\n"
    "    compatibility::{client_capability_matrix_summary, evaluate_client_compatibility},\n"
    "};\n",
    "import capability matrix evaluator",
)
registry = replace_once(
    registry,
    "    CanonicalEntityInput, ClientAccessMode, ClientCompatibilityState, ClientKind,\n",
    "    CanonicalEntityInput, ClientAccessMode, ClientKind,\n",
    "remove legacy compatibility import",
)
registry = replace_once(
    registry,
    '        "clientProtocolVersion":CLIENT_PROTOCOL_VERSION,\n',
    '        "clientProtocolVersion":CLIENT_PROTOCOL_VERSION,\n'
    '        "clientCapabilityMatrix":client_capability_matrix_summary()?,\n',
    "publish capability matrix status",
)
registry = replace_once(
    registry,
    "    let compatibility_state = compatibility_state(client_kind, &client_version, &protocol_version);\n"
    "    let write_capable = compatibility_state == ClientCompatibilityState::Verified;\n",
    "    let compatibility = evaluate_client_compatibility(\n"
    "        client_kind,\n"
    "        &client_version,\n"
    "        &protocol_version,\n"
    "        CLIENT_PROTOCOL_VERSION,\n"
    "        &capabilities,\n"
    "        &metadata,\n"
    "    )?;\n"
    "    let compatibility_state = compatibility.state;\n"
    "    let write_capable = compatibility.write_capable;\n",
    "evaluate exact client capability evidence",
)
registry = replace_once(
    registry,
    '        "compatibilityState":compatibility_state,\n'
    '        "productionClaimAllowed":false,\n',
    '        "compatibilityState":compatibility_state,\n'
    '        "compatibility":compatibility,\n'
    '        "productionClaimAllowed":false,\n',
    "return compatibility evidence",
)
pattern = re.compile(
    r"\nfn compatibility_state\(\n"
    r"    client_kind: ClientKind,\n"
    r"    client_version: &str,\n"
    r"    protocol_version: &str,\n"
    r"\) -> ClientCompatibilityState \{\n"
    r"    if client_kind == ClientKind::Cli\n"
    r"        && client_version == env!\(\"CARGO_PKG_VERSION\"\)\n"
    r"        && protocol_version == CLIENT_PROTOCOL_VERSION\n"
    r"    \{\n"
    r"        ClientCompatibilityState::Verified\n"
    r"    \} else \{\n"
    r"        ClientCompatibilityState::Unprobed\n"
    r"    \}\n"
    r"\}\n"
)
registry, count = pattern.subn("\n", registry, count=1)
if count != 1:
    raise SystemExit(f"remove legacy compatibility function: expected one match, found {count}")
write("native/daemon/ipc/src/registry.rs", registry)

print("P5 client capability matrix integration applied")
