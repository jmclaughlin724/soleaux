# Local dashboard-to-daemon connection
SOLEAUX_MODE=local
# Daemon base URL is the bare origin; every consumer appends /api/v1 itself.
SOLEAUX_DAEMON_URL=http://127.0.0.1:43120
SOLEAUX_DASHBOARD_ORIGIN=http://127.0.0.1:43121
SOLEAUX_BIND_ADDR=127.0.0.1:43120
SOLEAUX_LOG=soleaux_daemon=info,tower_http=info

# Local storage; implement before enabling history
SOLEAUX_DATABASE_URL=sqlite://./.soleaux/soleaux.db
SOLEAUX_RAW_RETENTION_MINUTES=30
SOLEAUX_AGGREGATE_RETENTION_DAYS=30
SOLEAUX_PRIVACY_MODE=balanced
SOLEAUX_PROCESS_CONTROL_ENABLED=false

# Exact API-usage synchronization. Use admin-scoped keys only for the sync
# process and store them in the operating-system credential store or secret
# manager. Do not expose these values to the dashboard or endpoint telemetry.
# OPENAI_ADMIN_KEY=
# ANTHROPIC_ADMIN_KEY=

# Request-level SDK instrumentation
# SOLEAUX_SESSION_ID=
# SOLEAUX_MODEL_ID=
# SOLEAUX_CONTEXT_WINDOW_TOKENS=

# Remote control-plane mode; placeholders until control-plane services exist
# SOLEAUX_MODE=remote
# SOLEAUX_API_URL=https://api.soleaux.example
# SOLEAUX_INGEST_URL=wss://ingest.soleaux.example/v1/agent
# SOLEAUX_DEVICE_ID=
# SOLEAUX_ORGANIZATION_ID=
# Device credentials must be stored in the operating-system credential store,
# not in this file.

# Hosted service infrastructure
# DATABASE_URL=postgresql://soleaux:change-me@postgres:5432/soleaux
# REDIS_URL=redis://redis:6379/0
# OTEL_EXPORTER_OTLP_ENDPOINT=
# SESSION_SECRET=
# ENROLLMENT_SIGNING_KEY=
