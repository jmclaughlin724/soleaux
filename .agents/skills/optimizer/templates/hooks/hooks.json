{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/PermissionRequest/PermissionRequest.mjs\"",
            "statusMessage": "Running PermissionRequest hook",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "^(Bash|apply_patch|Edit|Write)$"
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/PostCompact/PostCompact.mjs\"",
            "statusMessage": "Running PostCompact hook",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "^(manual|auto)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/PostToolUse/PostToolUse.mjs\"",
            "statusMessage": "Running PostToolUse hook",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "^(Bash|apply_patch|Edit|Write)$"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/PreCompact/PreCompact.mjs\"",
            "statusMessage": "Running PreCompact hook",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "^(manual|auto)$"
      }
