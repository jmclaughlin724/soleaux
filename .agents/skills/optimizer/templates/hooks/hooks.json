    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/PreToolUse/PreToolUse.mjs\"",
            "statusMessage": "Running PreToolUse hook",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "^(Bash|apply_patch|Edit|Write)$"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/SessionEnd/SessionEnd.mjs\"",
            "statusMessage": "Running SessionEnd hook",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "^other$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/SessionStart/SessionStart.mjs\"",
            "statusMessage": "Running SessionStart hook",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|clear|compact)$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/Stop/Stop.mjs\"",
            "statusMessage": "Running Stop hook",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/SubagentStart/SubagentStart.mjs\"",
            "statusMessage": "Running SubagentStart hook",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/SubagentStop/SubagentStop.mjs\"",
            "statusMessage": "Running SubagentStop hook",
            "timeout": 30,
            "type": "command"
          }
        ],
