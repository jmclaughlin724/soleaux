    },
    {
      "args": ["test:e2e"],
      "command": "pnpm",
      "group": "test",
      "label": "Root: E2E Tests",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "type": "process"
    },
    {
      "args": [
        ".codex/hooks/PostToolUse/workspace-diagnostics.mjs",
        "--workspace"
      ],
      "command": "node",
      "group": "test",
      "label": "Diagnostics: Workspace Linters",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "FORCE_COLOR": "0",
          "NO_COLOR": "1"
        }
      },
      "presentation": {
        "clear": true,
        "panel": "dedicated",
        "reveal": "silent",
        "revealProblems": "onProblem"
      },
      "problemMatcher": {
        "applyTo": "allDocuments",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "owner": "workspace-diagnostics",
        "pattern": {
          "code": 5,
          "column": 3,
          "file": 1,
          "line": 2,
          "message": 6,
          "regexp": "^::workspace-diagnostic::(.+):(\\d+):(\\d+):\\s+(error|warning|info)\\s+\\[([^\\]]+)\\]\\s+(.+)$",
          "severity": 4
        },
        "source": "Workspace diagnostics"
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "type": "process"
    },
    {
      "dependsOn": ["Root: Typecheck", "Diagnostics: Workspace Linters"],
      "label": "Diagnostics: Refresh Workspace",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
