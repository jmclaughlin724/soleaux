    {
      "args": [
        "exec",
        "turbo",
        "run",
        "typecheck",
        "--output-logs=errors-only",
        "--log-order=grouped",
        "--log-prefix=none"
      ],
      "command": "pnpm",
      "group": "test",
      "label": "Root: Typecheck",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "FORCE_COLOR": "0",
          "NO_COLOR": "1"
        }
      },
      "problemMatcher": "$tsc",
      "runOptions": {
        "instanceLimit": 1
      },
      "type": "process"
    },
    {
      "args": ["test"],
      "command": "pnpm",
